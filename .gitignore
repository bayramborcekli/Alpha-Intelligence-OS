# ═══════════════════════════════════════════════════════════════════
# Alpha Intelligence OS — .gitignore
# Son güncelleme: ownership-baseline-v1
# ═══════════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Sanal ortamlar ───────────────────────────────────────────────────
.env_dir/
.venv/
venv/
env/
ENV/
.pythonlibs/

# ── Sırlar ve kimlik bilgileri (ASLA commit edilmemeli) ──────────────
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.secret
*_secret*
*_private*

# ── Veritabanı dosyaları ─────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db3

# ── Yedekler (hassas veri içerebilir, repo dışında tutulur) ──────────
backups/

# ── Çalışma zamanı verileri (PAPER bot state) ────────────────────────
alpha20_v1/state.json
alpha20_v1/alpha20.log
alpha20_v1/.bot.pid
alpha20_v1/bot_process.log
alpha20_v1/safety_state.json
alpha20_v1/panel_status.json
alpha20_v1/*.jsonl
state.json
alpha20.log

# ── Log dosyaları ────────────────────────────────────────────────────
security.log
security.log.*
*.log
logs/
audit.log
restore_audit.log

# ── Geçici dosyalar ──────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── IDE ve editör dosyaları ──────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.iml

# ── Cache ────────────────────────────────────────────────────────────
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── İşletim sistemi dosyaları ────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Runtime state files
alpha20_v1/risk_events.jsonl

# Login rate-limit store (paylasimli SQLite)
login_attempts.db
login_attempts.db-*
