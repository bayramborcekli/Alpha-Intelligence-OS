      .intro { margin-bottom: 0; }
      .paper-badge { background: rgba(63,185,80,.13); border: 1px solid rgba(63,185,80,.45); border-radius: 10px; color: #7ee787; font-weight: 750; line-height: 1.45; padding: 12px 15px; }
