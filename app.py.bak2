  <body>
    <div class="shell">
      <header>
        <div>
          <p class="eyebrow">Alpha-20 v1</p>
          <h1>Kontrol Paneli</h1>
          <p class="intro">PAPER botunu, ayarlarını ve coin listesini tek yerden yönetin.</p>
        </div>
        <div class="paper-badge">PAPER modu aktif — Gerçek emir gönderilmez.</div>
      </header>

      {% if message %}
        <div class="message {{ 'success' if message_type == 'success' else 'error' }}" role="status">{{ message }}</div>
      {% endif %}

      {% if config_error %}
        <div class="message error" role="alert">Ayar dosyası okunamadı: {{ config_error }}</div>
      {% endif %}
      {% if state_error %}
        <div class="message error" role="alert">Bot durumu okunamadı: {{ state_error }}</div>
      {% endif %}

      <div class="grid">
        <section class="card status-card" id="bot-durumu">
          <div class="status-head">
            <h2>Bot Durumu</h2>
            <span class="status-badge {{ 'status-running' if status.running else 'status-stopped' }}">
              {{ 'Çalışıyor' if status.running else 'Durdu' }}
            </span>
          </div>
          <div class="metrics">
            <div class="metric"><span class="metric-label">PAPER bakiyesi</span><span class="metric-value">{{ status.balance }}</span></div>
            <div class="metric"><span class="metric-label">Gün başlangıcı</span><span class="metric-value">{{ status.day_start_balance }}</span></div>
            <div class="metric"><span class="metric-label">Ardışık zarar</span><span class="metric-value">{{ status.consecutive_losses }}</span></div>
            <div class="metric"><span class="metric-label">Tamamlanan işlem</span><span class="metric-value">{{ status.trade_count }}</span></div>
          </div>
          <div class="detail-grid">
            <div><strong>Son tarama</strong><span>{{ status.last_scan }}</span></div>
            <div><strong>Son log</strong><span>{{ status.last_log }}</span></div>
            <div><strong>Gün</strong><span>{{ status.day }}</span></div>
          </div>
          {% if status.position %}
            <div class="position-box">
              <h3>Açık Pozisyon</h3>
              <div class="detail-grid">
                <div><strong>Sembol / yön</strong><span>{{ status.position.symbol }} / {{ status.position.side }}</span></div>
                <div><strong>Giriş</strong><span>{{ status.position.entry }}</span></div>
                <div><strong>Stop</strong><span>{{ status.position.stop }}</span></div>
                <div><strong>Hedef</strong><span>{{ status.position.target }}</span></div>
                <div><strong>Miktar</strong><span>{{ status.position.quantity }}</span></div>
                <div><strong>Açılış</strong><span>{{ status.position.opened_at }}</span></div>
              </div>
            </div>
          {% else %}
            <div class="empty-box">Açık pozisyon bulunmuyor.</div>
          {% endif %}
        </section>

        <section class="card control-card" id="bot-kontrolu">
          <h2>Bot Kontrolü</h2>
          <p class="muted">Bot süreci yalnızca bu panel tarafından başlatıldıysa durdurulabilir.</p>
          <div class="button-row">
            <form method="post" action="/bot/start"><button class="primary" type="submit">Botu Başlat</button></form>
            <form method="post" action="/bot/stop"><button class="danger" type="submit">Botu Durdur</button></form>
          </div>
          {% if status.running %}
            <p class="note">Ayar veya coin listesi değişirse etkili olması için botu yeniden başlatın.</p>
          {% endif %}
        </section>

        <section class="card settings-card" id="ayarlar">
          <h2>Ayarlar</h2>
          <form method="post" action="/settings">
            <div class="setting-grid">
              {% for field in setting_fields %}
                <div class="setting-field">
                  <label for="{{ field.name }}">{{ field.label }}</label>
                  <input id="{{ field.name }}" name="{{ field.name }}" type="{{ field.input_type }}"
                    min="{{ field.min }}" max="{{ field.max }}" step="{{ field.step }}"
                    value="{{ field.value }}" required>
                  <small>{{ field.min }} – {{ field.max }}</small>
                </div>
              {% endfor %}
            </div>
            <div class="setting-footer">
              <span class="note">Yalnızca bu bölümdeki ayarlar değiştirilir. Bot çalışıyorsa yeniden başlatma gerekir.</span>
              <button class="primary" type="submit">Ayarları Kaydet</button>
            </div>
          </form>
        </section>

        <section class="card coins-card" id="coin-yonetimi">
          <h2>Coin Yönetimi</h2>
          <p class="muted">Aktif coinler botun config.json içindeki sırasıyla taranır.</p>
          <div class="coins-list">
            {% for coin in config.symbols %}
              <div class="coin-row">
                <span class="coin-name">{{ coin }}</span>
                <span class="coin-active">Aktif</span>
                <div class="button-row">
                  <form method="post" action="/coins/move"><input type="hidden" name="symbol" value="{{ coin }}"><input type="hidden" name="direction" value="up"><button class="secondary compact" type="submit" aria-label="{{ coin }} yukarı taşı">↑</button></form>
                  <form method="post" action="/coins/move"><input type="hidden" name="symbol" value="{{ coin }}"><input type="hidden" name="direction" value="down"><button class="secondary compact" type="submit" aria-label="{{ coin }} aşağı taşı">↓</button></form>
                  <form method="post" action="/coins/delete" onsubmit="return confirm('{{ coin }} silinsin mi?');"><input type="hidden" name="symbol" value="{{ coin }}"><button class="danger compact" type="submit">Sil</button></form>
                </div>
              </div>
            {% else %}
              <div class="empty-box">Coin listesi bulunamadı.</div>
            {% endfor %}
          </div>
          <form class="add-coin" method="post" action="/coins/add">
            <input name="symbol" placeholder="Örn. XRPUSDT" maxlength="30" required aria-label="Yeni coin sembolü">
            <button class="primary" type="submit">Coin Ekle</button>
          </form>
          <div class="preset-row">
            <h3>Hazır listeler</h3>
            <div class="button-row">
              <form method="post" action="/coins/preset" onsubmit="return confirm('Mevcut coin listesi Varsayılan 3 ile değiştirilsin mi?');"><input type="hidden" name="preset" value="default"><button class="secondary" type="submit">Varsayılan 3</button></form>
              <form method="post" action="/coins/preset" onsubmit="return confirm('Mevcut coin listesi Top 10 ile değiştirilsin mi?');"><input type="hidden" name="preset" value="top10"><button class="secondary" type="submit">Top 10</button></form>
              <form method="post" action="/coins/preset" onsubmit="return confirm('Mevcut coin listesi Top 20 ile değiştirilsin mi?');"><input type="hidden" name="preset" value="top20"><button class="secondary" type="submit">Top 20</button></form>
            </div>
          </div>
        </section>

        <section class="card history-card" id="islem-gecmisi">
          <h2>İşlem Geçmişi</h2>
          {% if status.trades %}
            <div class="history-wrap">
              <table>
                <thead><tr><th>Sembol</th><th>Yön</th><th>Açılış</th><th>Kapanış</th><th>Sonuç</th><th>Kâr/Zarar</th><th>Bakiye</th></tr></thead>
                <tbody>
                  {% for trade in status.trades %}
                    <tr>
                      <td>{{ trade.symbol }}</td><td>{{ trade.side }}</td><td>{{ trade.opened_at }}</td><td>{{ trade.closed_at }}</td>
                      <td class="{{ 'win' if trade.result == 'WIN' else 'loss' }}">{{ trade.result }}</td><td>{{ trade.pnl }}</td><td>{{ trade.balance_after }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <div class="empty-box">Tamamlanmış işlem bulunmuyor.</div>
          {% endif %}
        </section>
      </div>

      <p class="note" style="margin: 18px 2px 0;">Uyarı: Sinyal skorunu veya risk ayarlarını değiştirmek kârlılığı garanti etmez. Geçmiş sonuçlar gelecekteki performansın göstergesi değildir.</p>
    </div>
    <script>
      async function refreshStatus() {
        try {
          const response = await fetch("/api/status", { cache: "no-store" });
          if (!response.ok) return;
          const data = await response.json();
          const badge = document.querySelector(".status-badge");
          if (badge) {
            badge.textContent = data.running ? "Çalışıyor" : "Durdu";
            badge.classList.toggle("status-running", data.running);
            badge.classList.toggle("status-stopped", !data.running);
          }
        } catch (_) {
          // Durum yenileme hatası paneli kullanılamaz hale getirmemeli.
        }
      }
      setInterval(refreshStatus, 5000);
    </script>
  </body>
</html>
"""


def read_json(path: Path) -> tuple[dict[str, Any] | None, str | None]:
    if not path.exists():
        return None, f"{path.name} dosyası bulunamadı."
    try:
        with path.open("r", encoding="utf-8") as file:
            value = json.load(file)
        if not isinstance(value, dict):
            return None, f"{path.name} geçerli bir nesne içermiyor."
        return value, None
    except (OSError, json.JSONDecodeError) as exc:
        return None, f"{path.name} okunamadı ({type(exc).__name__})."


def load_config() -> tuple[dict[str, Any] | None, str | None]:
    config, error = read_json(CONFIG_PATH)
    if error or config is None:
        return None, error
    if not isinstance(config.get("symbols"), list):
        return None, "config.json içindeki symbols listesi geçersiz."
    return config, None


def atomic_write_json(path: Path, data: dict[str, Any]) -> None:
    temporary_path = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with temporary_path.open("w", encoding="utf-8") as file:
            json.dump(data, file, ensure_ascii=False, indent=2)
            file.write("\n")
            file.flush()
            os.fsync(file.fileno())
        temporary_path.replace(path)
    finally:
        if temporary_path.exists():
            temporary_path.unlink()


def update_config(updates: dict[str, Any]) -> tuple[bool, str]:
    with CONFIG_LOCK:
        config, error = load_config()
        if error or config is None:
            return False, error or "Ayar dosyası okunamadı."
        updated = dict(config)
        updated.update(updates)
        try:
            atomic_write_json(CONFIG_PATH, updated)
        except OSError as exc:
            return False, f"Ayarlar kaydedilemedi ({type(exc).__name__})."
    return True, "Ayarlar başarıyla kaydedildi."


def parse_setting(name: str, raw_value: str | None) -> int | float | None:
    if raw_value is None:
        return None
    kind, minimum, maximum = SETTING_RULES[name]
    value = raw_value.strip()
    if kind == "int":
        if not INTEGER_PATTERN.fullmatch(value):
            return None
        parsed: int | float = int(value)
    else:
        try:
            decimal = Decimal(value)
            if not decimal.is_finite():
                return None
            parsed = float(decimal)
        except (InvalidOperation, ValueError):
            return None
        if not math.isfinite(float(parsed)):
            return None
    if not minimum <= parsed <= maximum:
        return None
    return parsed


def normalize_symbol(raw_symbol: str | None) -> str | None:
    if raw_symbol is None:
        return None
    symbol = raw_symbol.strip().upper()
    return symbol if SYMBOL_PATTERN.fullmatch(symbol) else None


def save_symbols(symbols: list[str]) -> tuple[bool, str]:
    return update_config({"symbols": symbols})


def process_cmdline(pid: int) -> list[str] | None:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        return [part.decode("utf-8", errors="replace") for part in raw.split(b"\0") if part]
    except (OSError, ValueError):
        return None


def is_bot_command(pid: int) -> bool:
    command = process_cmdline(pid)
    if not command:
        return False
    return any(Path(part).resolve() == BOT_PATH for part in command if part.endswith(".py"))


def find_bot_pids() -> list[int]:
    pids: list[int] = []
    for entry in Path("/proc").iterdir():
        if entry.name.isdigit():
            pid = int(entry.name)
            if pid != os.getpid() and is_bot_command(pid):
                pids.append(pid)
    return pids


def read_pid() -> int | None:
    if not PID_PATH.exists():
        return None
    try:
        with PID_PATH.open("r", encoding="utf-8") as file:
            payload = json.load(file)
        pid = int(payload["pid"])
        return pid if pid > 0 else None
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
        return None


def write_pid(pid: int) -> None:
    atomic_write_json(PID_PATH, {"pid": pid, "started_at": datetime.now(timezone.utc).isoformat()})


def bot_running() -> bool:
    return bool(find_bot_pids())


def start_bot() -> tuple[bool, str]:
    with CONFIG_LOCK:
        pids = find_bot_pids()
        if pids:
            if read_pid() in pids:
                return False, "Bot zaten çalışıyor."
            return False, "Bot zaten çalışıyor; ikinci bir süreç başlatılmadı."
        if not BOT_PATH.exists():
            return False, "Bot dosyası bulunamadı."
        try:
            output = BOT_OUTPUT_PATH.open("a", encoding="utf-8")
            process = subprocess.Popen(
                [sys.executable, str(BOT_PATH)],
                cwd=str(ROOT),
                stdin=subprocess.DEVNULL,
                stdout=output,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )
            write_pid(process.pid)
            output.close()
        except (OSError, ValueError) as exc:
            return False, f"Bot başlatılamadı ({type(exc).__name__})."
    return True, "Bot başlatıldı."


def stop_bot() -> tuple[bool, str]:
    with CONFIG_LOCK:
        pid = read_pid()
        if pid is None or not is_bot_command(pid):
            if PID_PATH.exists():
                try:
                    PID_PATH.unlink()
                except OSError:
                    pass
            return False, "Uygulamanın başlattığı çalışan bir bot bulunamadı."
        try:
            os.kill(pid, signal.SIGTERM)
            for _ in range(20):
                if not Path(f"/proc/{pid}").exists():
                    break
                time.sleep(0.1)
            if Path(f"/proc/{pid}").exists():
                os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        except OSError as exc:
            return False, f"Bot durdurulamadı ({type(exc).__name__})."
        try:
            PID_PATH.unlink()
        except OSError:
            pass
    return True, "Bot durduruldu."


def display_value(value: Any, fallback: str = "Bilinmiyor") -> str:
    if value is None:
        return fallback
    if isinstance(value, float):
        return f"{value:.8g}"
    return str(value)


def read_last_log() -> tuple[str, str]:
    if not LOG_PATH.exists():
        return "Log dosyası bulunamadı.", "Bilinmiyor"
    try:
        lines = [line.strip() for line in LOG_PATH.read_text(encoding="utf-8", errors="replace").splitlines() if line.strip()]
        last_line = lines[-1] if lines else "Henüz log mesajı yok."
        match = LOG_TIMESTAMP_PATTERN.match(last_line)
        if match:
            scan_time = f"{match.group('timestamp')} UTC"
        else:
            scan_time = datetime.fromtimestamp(LOG_PATH.stat().st_mtime, timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        return last_line[-500:], scan_time
    except OSError as exc:
        return f"Log okunamadı ({type(exc).__name__}).", "Bilinmiyor"


def build_status() -> tuple[dict[str, Any], str | None]:
    state, state_error = read_json(STATE_PATH)
    log_message, last_scan = read_last_log()
    state = state or {}
    position = state.get("position")
    trades = state.get("trades") if isinstance(state.get("trades"), list) else []
    status = {
        "running": bot_running(),
        "balance": display_value(state.get("balance")),
        "day_start_balance": display_value(state.get("day_start_balance")),
        "consecutive_losses": display_value(state.get("consecutive_losses"), "0"),
        "trade_count": len(trades),
        "day": display_value(state.get("day")),
        "last_scan": last_scan,
        "last_log": log_message,
        "position": position if isinstance(position, dict) else None,
        "trades": list(reversed(trades[-10:])),
    }
    return status, state_error


def setting_fields(config: dict[str, Any] | None) -> list[dict[str, Any]]:
    config = config or DEFAULT_CONFIG
    labels = {
        "minimum_score": ("Minimum Sinyal Skoru", "number", "1"),
        "scan_seconds": ("Tarama Aralığı (saniye)", "number", "1"),
        "risk_per_trade_pct": ("İşlem Başına Risk (%)", "number", "0.1"),
        "daily_loss_limit_pct": ("Günlük Zarar Limiti (%)", "number", "0.1"),
        "max_consecutive_losses": ("Maksimum Ardışık Zarar", "number", "1"),
        "reward_risk_ratio": ("Ödül / Risk Oranı", "number", "0.1"),
        "atr_stop_multiplier": ("ATR Stop Çarpanı", "number", "0.1"),
        "max_open_positions": ("Maksimum Açık Pozisyon", "number", "1"),
    }
    fields = []
    for name, (kind, minimum, maximum) in SETTING_RULES.items():
        label, input_type, step = labels[name]
        fields.append({
            "name": name,
            "label": label,
            "input_type": input_type,
            "min": minimum,
            "max": maximum,
            "step": step,
            "value": config.get(name, DEFAULT_CONFIG[name]),
        })
    return fields


def render_dashboard(message: str | None = None, message_type: str = "success"):
    config, config_error = load_config()
    status, state_error = build_status()
    safe_config = config or DEFAULT_CONFIG
    return render_template_string(
        PAGE_TEMPLATE,
        config=safe_config,
        status=status,
        setting_fields=setting_fields(config),
        config_error=config_error,
        state_error=state_error,
        message=message,
        message_type=message_type,
    )


@app.route("/", methods=["GET"])
def index():
    return render_dashboard()


@app.post("/settings")
def save_settings():
    updates: dict[str, Any] = {}
    for name in SETTING_RULES:
        parsed = parse_setting(name, request.form.get(name))
        if parsed is None:
            _, minimum, maximum = SETTING_RULES[name]
            return render_dashboard(
                f"Hata: {name} değeri {minimum} ile {maximum} arasında geçerli bir sayı olmalıdır.",
                "error",
            )
        updates[name] = parsed
    success, message = update_config(updates)
    if success and bot_running():
        message += " Değişikliklerin etkili olması için botu yeniden başlatın."
    return render_dashboard(message, "success" if success else "error")


@app.post("/coins/add")
def add_coin():
    symbol = normalize_symbol(request.form.get("symbol"))
    config, error = load_config()
    if error or config is None:
        return render_dashboard(error or "Ayar dosyası okunamadı.", "error")
    symbols = [str(item) for item in config.get("symbols", [])]
    if symbol is None:
        return render_dashboard("Hata: Sembol yalnızca A-Z ve 0-9 içermeli ve USDT ile bitmelidir.", "error")
    if symbol in symbols:
        return render_dashboard(f"Hata: {symbol} zaten listede.", "error")
    success, message = save_symbols(symbols + [symbol])
    if success and bot_running():
        message += " Bot çalışıyor; etkili olması için botu yeniden başlatın."
    return render_dashboard(message, "success" if success else "error")


@app.post("/coins/delete")
def delete_coin():
    symbol = normalize_symbol(request.form.get("symbol"))
    config, error = load_config()
    if error or config is None:
        return render_dashboard(error or "Ayar dosyası okunamadı.", "error")
    symbols = [str(item) for item in config.get("symbols", [])]
    if symbol is None or symbol not in symbols:
        return render_dashboard("Hata: Silinecek coin bulunamadı.", "error")
    if len(symbols) <= 1:
        return render_dashboard("Hata: En az bir coin listede kalmalıdır.", "error")
    success, message = save_symbols([item for item in symbols if item != symbol])
    if success and bot_running():
        message += " Bot çalışıyor; etkili olması için botu yeniden başlatın."
    return render_dashboard(message, "success" if success else "error")


@app.post("/coins/move")
def move_coin():
    symbol = normalize_symbol(request.form.get("symbol"))
    direction = request.form.get("direction")
    config, error = load_config()
    if error or config is None:
        return render_dashboard(error or "Ayar dosyası okunamadı.", "error")
    symbols = [str(item) for item in config.get("symbols", [])]
    if symbol not in symbols or direction not in {"up", "down"}:
        return render_dashboard("Hata: Coin sıralaması değiştirilemedi.", "error")
    index = symbols.index(symbol)
    new_index = index - 1 if direction == "up" else index + 1
    if new_index < 0 or new_index >= len(symbols):
        return render_dashboard("Coin zaten listenin sınırında.", "error")
    symbols[index], symbols[new_index] = symbols[new_index], symbols[index]
    success, message = save_symbols(symbols)
    if success and bot_running():
        message += " Bot çalışıyor; etkili olması için botu yeniden başlatın."
    return render_dashboard(message, "success" if success else "error")


@app.post("/coins/preset")
def apply_preset():
    preset_name = request.form.get("preset")
    symbols = DEFAULT_PRESETS.get(preset_name or "")
    if symbols is None:
        return render_dashboard("Hata: Geçersiz hazır liste.", "error")
    success, message = save_symbols(list(symbols))
    if success:
        message = "Hazır coin listesi başarıyla kaydedildi."
        if bot_running():
            message += " Bot çalışıyor; etkili olması için botu yeniden başlatın."
    return render_dashboard(message, "success" if success else "error")


@app.post("/bot/start")
def bot_start():
    success, message = start_bot()
    return render_dashboard(message, "success" if success else "error")


@app.post("/bot/stop")
def bot_stop():
    success, message = stop_bot()
    return render_dashboard(message, "success" if success else "error")


@app.get("/api/status")
def api_status():
    status, error = build_status()
    response = dict(status)
    response["error"] = error
    return response


@app.get("/favicon.ico")
def favicon():
    return "", 204


if __name__ == "__main__":
    port = int(os.environ.get("PORT", "5000"))
    app.run(host="0.0.0.0", port=port)