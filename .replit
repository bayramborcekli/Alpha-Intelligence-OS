args = "Alpha-20 PAPER scan"

[[workflows.workflow]]
name = "Alpha-20 PAPER scan"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python alpha20_v1/alpha20.py --once"

[workflows.workflow.metadata]
outputType = "console"
