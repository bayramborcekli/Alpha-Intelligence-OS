# ═══════════════════════════════════════════════════════════════════
# Alpha Intelligence OS — Örnek ortam değişkenleri
# ─────────────────────────────────────────────────────────────────
# Kullanım:
#   cp .env.example .env
#   .env dosyasını gerçek değerlerle doldurun.
#
# UYARI: .env dosyası asla git'e commit edilmemelidir.
#        Gerçek sırlar yalnızca .env veya Replit Secrets'ta saklanır.
# ═══════════════════════════════════════════════════════════════════

# ── Flask oturum şifreleme anahtarı (ZORUNLU) ───────────────────────
# Güçlü, rastgele ve benzersiz olmalıdır.
# Üretmek için: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here-change-this

# ── Admin kimlik bilgileri (ZORUNLU) ────────────────────────────────
# Kullanıcı adı (varsayılan: admin)
ADMIN_USERNAME=admin

# Bcrypt/PBKDF2 hash — düz metin parola ASLA yazılmaz.
# Hash üretmek için:
#   python3 -c "from werkzeug.security import generate_password_hash; \
#               print(generate_password_hash('güçlü-parolanız'))"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:...your-hash-here...

# ── Ortam ve port ────────────────────────────────────────────────────
# development | production
# production'da: Secure cookie, HSTS aktif olur.
FLASK_ENV=production
PORT=5000

# ── Güvenli mod (DEĞİŞTİRMEYİN — PAPER kilidi) ──────────────────────
# Bu değer true olmak ZORUNDADIR. Canlı emir gönderimi desteklenmez.
PAPER_MODE=true

# ── Oturum zaman aşımı (saniye) ─────────────────────────────────────
# Varsayılan: 28800 (8 saat). Değiştirmek için bu satırı açın.
# SESSION_TIMEOUT_SECONDS=28800

# ── Canlı borsa bağlantısı (BU SÜRÜMDE KULLANILMAZ) ─────────────────
# Aşağıdaki değişkenler PAPER modunda okunmaz.
# Canlı mod planlanmamıştır; bu satırları dolu bırakmayın.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# EXCHANGE_ADAPTER=

# ── Yedekleme ────────────────────────────────────────────────────────
# Yedek dizini (varsayılan: ./backups — .gitignore'da)
# BACKUP_DIR=./backups
