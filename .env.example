# ═══════════════════════════════════════════════════════════════════
# Alpha Intelligence OS — Örnek ortam değişkenleri
# ─────────────────────────────────────────────────────────────────
# Kullanım:
#   cp .env.example .env
#   .env dosyasını gerçek değerlerle doldurun.
#
# UYARI: .env dosyası asla git'e commit edilmemelidir.
#        Gerçek sırlar yalnızca .env veya Replit Secrets'ta saklanır.
# ═══════════════════════════════════════════════════════════════════

# ── Flask oturum şifreleme anahtarı (ZORUNLU) ───────────────────────
# Güçlü, rastgele ve benzersiz olmalıdır.
# Üretmek için: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here-change-this

# Alternatif isim: SESSION_SECRET (FLASK_SECRET_KEY yoksa bu kullanılır).
# Windows lokal kullanımda bu değer SABİT kalmalıdır — boş bırakılırsa her
# yeniden başlatmada geçici anahtar üretilir ve TÜM oturumlar düşer
# (panel API'leri 401 döner, üst çubuk "Veri Alınamadı (oturum)" gösterir).
SESSION_SECRET=

# ── Admin kimlik bilgileri (ZORUNLU) ────────────────────────────────
# Kullanıcı adı (varsayılan: admin)
ADMIN_USERNAME=admin

# Bcrypt/PBKDF2 hash — düz metin parola ASLA yazılmaz.
# Hash üretmek için:
#   python3 -c "from werkzeug.security import generate_password_hash; \
#               print(generate_password_hash('güçlü-parolanız'))"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:...your-hash-here...

# ── Ortam ve port ────────────────────────────────────────────────────
# development | production
# production'da: Secure cookie, HSTS aktif olur.
FLASK_ENV=production
PORT=5000

# ── Güvenli mod (DEĞİŞTİRMEYİN — PAPER kilidi) ──────────────────────
# Bu değer true olmak ZORUNDADIR. Canlı emir gönderimi desteklenmez.
PAPER_MODE=true

# ── GEÇİCİ lokal test bypass'ı (yalnız Windows/lokal geliştirme) ────
# 1 yapılırsa parola ekranı atlanır ve 'local-dev-bypass' test
# kullanıcısı otomatik giriş yapar. Replit'te ve production'da
# (FLASK_ENV=production / yayın) ASLA çalışmaz. Test bitince silin.
# Not: Çalışması için yukarıdaki FLASK_ENV=development olmalıdır.
# LOCAL_DEV_BYPASS=1

# ── Oturum zaman aşımı (saniye) ─────────────────────────────────────
# Varsayılan: 28800 (8 saat). Değiştirmek için bu satırı açın.
# SESSION_TIMEOUT_SECONDS=28800

# ── Binance hesap bağlantısı (SALT-OKUNUR portföy görünümü) ─────────
# PAPER kilidi değişmez: bu anahtarlar yalnızca bakiye/portföy okumak
# için kullanılır, canlı emir gönderimi yoktur.
# Kanonik isimler AYNEN böyledir (büyük/küçük harf önemli):
#
# Binance Global hesabı:
BINANCE_GLOBAL_API_Key=
BINANCE_GLOBAL_Secret_Key=
#
# Binance TR hesabı:
BINANCE_TR_API_KEY=
BINANCE_TR_API_SECRET=

# ── Yedekleme ────────────────────────────────────────────────────────
# Yedek dizini (varsayılan: ./backups — .gitignore'da)
# BACKUP_DIR=./backups
