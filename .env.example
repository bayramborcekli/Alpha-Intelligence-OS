# Alpha-20 v1 — Örnek ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri doldurun.
# .env dosyası asla git'e commit edilmemelidir.

# Flask oturum şifreleme anahtarı (zorunlu — güçlü, rastgele bir değer kullanın)
# Üretmek için: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here-change-this

# Admin giriş bilgileri
ADMIN_USERNAME=admin

# Hash üretmek için:
# python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:...your-hash-here...

# Ortam tipi: development | production
# production'da Secure cookie ve HSTS aktif olur
FLASK_ENV=production

# Uygulama portu (varsayılan: 5000)
PORT=5000

# --- Aşağıdakiler bu sürümde kullanılmaz (PAPER modunda API gerekli değil) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# DATABASE_URL=
